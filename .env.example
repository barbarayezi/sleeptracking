# Turso cloud database credentials
# 1. Create a free account at https://turso.tech
# 2. Create a database: turso db create sleep-tracker
# 3. Get the URL:    turso db show sleep-tracker --url
# 4. Get the token:  turso db tokens create sleep-tracker
# 5. Copy .env.example to .env and fill in the values
TURSO_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Whoop API credentials (https://developer-dashboard.whoop.com)
WHOOP_CLIENT_ID=your-client-id-here
WHOOP_CLIENT_SECRET=your-client-secret-here

# Health sync shared key — protects /api/healthkit/ingest from unauthenticated writes.
# Generate a strong random value (e.g. `python3 -c "import secrets;print(secrets.token_urlsafe(24))"`)
# and pass it from the client via URL (?key=...) or header (X-Api-Key: ...).
# iPhone Shortcuts calling the ingest endpoint must include this key, otherwise they get 401.
HEALTHKIT_API_KEY=your-shared-ingest-key-here

# Deployment: set this to your cloud URL (Render/Railway etc.)
# WHOOP_REDIRECT_URI=https://your-app.onrender.com/api/whoop/callback