# Turso cloud database credentials
# 1. Create a free account at https://turso.tech
# 2. Create a database: turso db create sleep-tracker
# 3. Get the URL:    turso db show sleep-tracker --url
# 4. Get the token:  turso db tokens create sleep-tracker
# 5. Copy .env.example to .env and fill in the values
TURSO_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here